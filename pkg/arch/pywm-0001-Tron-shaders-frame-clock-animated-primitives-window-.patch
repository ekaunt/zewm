diff --git a/src/wm/shaders/primitive/tron_grid/fragment.glsl b/src/wm/shaders/primitive/tron_grid/fragment.glsl
new file mode 100644
index 0000000..93cbcb7
--- /dev/null
+++ b/src/wm/shaders/primitive/tron_grid/fragment.glsl
@@ -0,0 +1,144 @@
+#ifdef GL_FRAGMENT_PRECISION_HIGH
+precision highp float;
+#else
+precision mediump float;
+#endif
+/*
+ * Animated Tron grid: perspective floor, horizon glow, ridge line and
+ * two light cycles leaving trails.
+ *
+ * 0-3   world box in widget px (x, y, w, h): pans and zooms with the ZUI
+ * 4-6   grid color
+ * 7-9   accent color (second light cycle)
+ * 10    scroll speed of the floor (units per second)
+ */
+uniform float params_float[11];
+uniform float alpha;
+uniform float time;
+varying vec2 v_texcoord;
+
+uniform float width;
+uniform float height;
+
+float hash1(float n){ return fract(sin(n * 127.1) * 43758.5453); }
+
+/* Distance from p to segment ab, and position of the closest point along it */
+vec2 seg(vec2 p, vec2 a, vec2 b){
+    vec2 ab = b - a;
+    float l = max(length(ab), 1e-4);
+    float t = clamp(dot(p - a, ab) / (l * l), 0.0, 1.0);
+    return vec2(length(p - (a + ab * t)), t * l);
+}
+
+/* Light cycle trail on the floor (camera frame): brightness at floor point fp */
+float cycle(vec2 fp, float seed, float period, float pxw){
+    float ph = time / period + seed;
+    float k = floor(ph);
+    float u = fract(ph);
+
+    /* Path: runs toward the camera along Z with lateral 90 degree turns */
+    vec2 a = vec2(floor((hash1(k + seed * 7.0) - 0.5) * 14.0), 46.0);
+    float total = 0.0;
+    vec2 pts[9];
+    pts[0] = a;
+    for(int i = 1; i < 9; i++){
+        vec2 prev = pts[i - 1];
+        if(mod(float(i), 2.0) > 0.5){
+            prev.y -= 5.0 + floor(hash1(k * 13.0 + float(i) + seed) * 6.0);
+        }else{
+            float dx = floor((hash1(k * 17.0 + float(i) + seed * 3.0) - 0.5) * 10.0);
+            if(abs(prev.x + dx) > 9.0) dx = -dx;
+            prev.x += dx;
+        }
+        pts[i] = prev;
+        total += length(pts[i] - pts[i - 1]);
+    }
+
+    float head = u * total;
+    float tail = 16.0;
+    float best = 0.0;
+    float acc = 0.0;
+    for(int i = 1; i < 9; i++){
+        float l = length(pts[i] - pts[i - 1]);
+        if(acc < head){
+            vec2 b = pts[i];
+            if(acc + l > head) b = pts[i - 1] + (pts[i] - pts[i - 1]) * ((head - acc) / max(l, 1e-4));
+            vec2 d = seg(fp, pts[i - 1], b);
+            float behind = head - (acc + d.y);
+            float fade = exp(-behind / tail * 2.5);
+            float w = max(0.05, pxw);
+            float core = 1.0 - smoothstep(w, w * 2.0, d.x);
+            float glow = exp(-d.x / 0.35) * 0.5;
+            best = max(best, (core + glow) * fade);
+        }
+        acc += l;
+    }
+    return best;
+}
+
+void main() {
+    vec2 frag = v_texcoord * vec2(width, height);
+    vec3 gcol = vec3(params_float[4], params_float[5], params_float[6]);
+    vec3 acol = vec3(params_float[7], params_float[8], params_float[9]);
+
+    /* Camera from the ZUI viewport: pan sideways/forward, rise when zoomed out */
+    float bw = max(params_float[2], 1.0);
+    float bh = max(params_float[3], 1.0);
+    float pan_x = (0.5 * width - params_float[0]) / bw;
+    float pan_z = (0.5 * height - params_float[1]) / bh;
+    float vis = clamp(width / bw, 0.05, 1.0);
+    float cam_h = 0.8 + 2.5 * vis;
+
+    vec2 q = (frag - 0.5 * vec2(width, height)) / height;
+    float hy = -0.08;
+    float d = q.y - hy;
+
+    /* Sky */
+    vec3 col = mix(vec3(0.02, 0.07, 0.10), vec3(0.0, 0.005, 0.015), smoothstep(0.0, 0.5, -d));
+
+    /* Distant ridge with a lit edge */
+    float rx = q.x + pan_x * 0.6;
+    float ridge = 0.045 * (0.6 + 0.4 * sin(rx * 3.1 + 1.3)) * (0.5 + 0.5 * sin(rx * 7.3))
+                + 0.02 * sin(rx * 17.0 + 0.7);
+    ridge = max(ridge, 0.0);
+    float ry = hy - ridge;
+    if(q.y > ry && d < 0.0) col = vec3(0.0, 0.01, 0.02);
+    col += gcol * exp(-abs(q.y - ry) * height / 1.5) * 0.7 * step(0.002, ridge);
+
+    if(d > 0.0){
+        /* Floor */
+        float z = cam_h / d;
+        float x = q.x * z;
+        vec2 fp = vec2(x + pan_x * 60.0, z + time * params_float[10] + pan_z * 60.0);
+
+        float pxz = cam_h / (d * d * height);
+        float pxx = z / height;
+        vec2 cellp = abs(fract(fp) - 0.5);
+        vec2 lw = max(vec2(pxx, pxz) * 0.9, vec2(0.012));
+        float lx = 1.0 - smoothstep(0.5 - lw.x * 2.0, 0.5 - lw.x, cellp.x);
+        float lz = 1.0 - smoothstep(0.5 - lw.y * 2.0, 0.5 - lw.y, cellp.y);
+        /* Fade lines out where they get thinner than a pixel */
+        lx = (1.0 - lx) * (1.0 - smoothstep(0.08, 0.35, pxx));
+        lz = (1.0 - lz) * (1.0 - smoothstep(0.08, 0.35, pxz));
+        float grid = max(lx, lz);
+        float gglow = exp(-min(0.5 - cellp.x, 0.5 - cellp.y) / 0.08) * 0.25;
+
+        float fog = exp(-z * 0.045);
+        col = mix(col, vec3(0.0, 0.01, 0.02), 1.0 - exp(-d * 10.0));
+        col += gcol * (grid * 0.85 + gglow) * fog;
+
+        /* Light cycles run in the camera frame */
+        vec2 cp = vec2(x, z);
+        float pxw = max(pxx, pxz);
+        col += gcol * 1.3 * cycle(cp, 0.13, 9.0, pxw) * exp(-z * 0.03);
+        col += acol * 1.3 * cycle(cp, 0.61, 11.0, pxw) * exp(-z * 0.03);
+    }
+
+    /* Horizon glow */
+    float hd = abs(d);
+    col += mix(gcol, vec3(1.0), 0.5) * exp(-hd * height / 2.0) * 0.9;
+    col += gcol * exp(-hd * 14.0) * 0.25;
+
+    col = 1.0 - exp(-col * 1.4);
+    gl_FragColor = vec4(col, 1.0) * alpha;
+}

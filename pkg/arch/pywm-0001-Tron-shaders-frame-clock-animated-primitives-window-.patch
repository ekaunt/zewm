diff --git a/src/wm/shaders/primitive/tron_border/fragment.glsl b/src/wm/shaders/primitive/tron_border/fragment.glsl
new file mode 100644
index 0000000..d393162
--- /dev/null
+++ b/src/wm/shaders/primitive/tron_border/fragment.glsl
@@ -0,0 +1,65 @@
+precision mediump float;
+/*
+ * 0-3   primary color (r, g, b, a)
+ * 4-7   secondary color (r, g, b, a) - the second light cycle
+ * 8     corner radius of the line
+ * 9     line width
+ * 10    inset: distance from widget edge to line centre (room for glow)
+ * 11    glow falloff in px
+ * 12    laps per second of the racing streaks
+ */
+uniform float params_float[13];
+uniform float alpha;
+uniform float time;
+varying vec2 v_texcoord;
+
+uniform float width;
+uniform float height;
+
+void main() {
+    vec2 p = (v_texcoord - 0.5) * vec2(width, height);
+    float inset = params_float[10];
+    vec2 half_ext = 0.5 * vec2(width, height) - inset;
+    float r = min(params_float[8], min(half_ext.x, half_ext.y));
+
+    /* Signed distance to the rounded rectangle the line runs along */
+    vec2 q = abs(p) - half_ext + r;
+    float sd = length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
+    float dist = abs(sd);
+
+    float lw = 0.5 * params_float[9];
+    float core = 1.0 - smoothstep(lw - 0.75, lw + 0.75, dist);
+    float glow = exp(-max(dist - lw, 0.0) / max(params_float[11], 0.1));
+
+    /* Position along the perimeter, clockwise from the top left corner */
+    float hw = half_ext.x;
+    float hh = half_ext.y;
+    float perim = 4.0 * (hw + hh);
+    float s;
+    if(hw - abs(p.x) < hh - abs(p.y)){
+        s = p.x > 0.0 ? 2.0 * hw + (p.y + hh) : 4.0 * hw + 2.0 * hh + (hh - p.y);
+    }else{
+        s = p.y < 0.0 ? (p.x + hw) : 2.0 * hw + 2.0 * hh + (hw - p.x);
+    }
+
+    float head = fract(time * params_float[12]) * perim;
+    float tail = 0.35 * perim;
+    float b1 = mod(head - s, perim);
+    float b2 = mod(head + 0.5 * perim - s, perim);
+    float st1 = exp(-3.0 * b1 / tail) + 2.0 * exp(-b1 / 6.0);
+    float st2 = exp(-3.0 * b2 / tail) + 2.0 * exp(-b2 / 6.0);
+
+    float pulse = 0.8 + 0.2 * sin(time * 2.2);
+
+    vec3 c1 = vec3(params_float[0], params_float[1], params_float[2]);
+    vec3 c2 = vec3(params_float[4], params_float[5], params_float[6]);
+
+    vec3 base = c1 * (core * pulse + glow * 0.55 * pulse);
+    vec3 streaks = (c1 * st1 + c2 * st2) * (core * 1.2 + glow * 0.8);
+    /* White-hot centre of the line near each streak head */
+    vec3 hot = vec3(1.0) * core * (exp(-b1 / 10.0) + exp(-b2 / 10.0)) * 0.8;
+
+    vec3 col = base + streaks + hot;
+    float a = clamp(max(core, glow * 0.6) * params_float[3], 0.0, 1.0);
+    gl_FragColor = vec4(col * params_float[3], a) * alpha;
+}

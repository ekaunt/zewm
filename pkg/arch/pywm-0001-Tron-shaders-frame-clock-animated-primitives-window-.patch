diff --git a/src/wm/shaders/texture/tron/fragment_ext.glsl b/src/wm/shaders/texture/tron/fragment_ext.glsl
new file mode 100644
index 0000000..7899908
--- /dev/null
+++ b/src/wm/shaders/texture/tron/fragment_ext.glsl
@@ -0,0 +1,93 @@
+#extension GL_OES_EGL_image_external : require
+precision mediump float;
+
+varying vec2 v_texcoord;
+uniform samplerExternalOES texture0;
+uniform float alpha;
+
+uniform float offset_x;
+uniform float offset_y;
+uniform float scale_x;
+uniform float scale_y;
+uniform float width;
+uniform float height;
+
+uniform float padding_l;
+uniform float padding_t;
+uniform float padding_r;
+uniform float padding_b;
+uniform float cornerradius;
+uniform float lock_perc;
+
+uniform float time;
+uniform float fx_age;
+
+/* Rez-in: a cyan scan front sweeps down the window, leaving a wireframe
+ * construct ahead of it and the real contents behind it. */
+const float REZ_T = 0.45;
+
+float rez_hash(vec2 p){
+    return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453);
+}
+
+vec4 rez(vec4 c, float x, float y){
+    if(fx_age >= REZ_T) return c;
+    float w = width - padding_l - padding_r;
+    float h = height - padding_t - padding_b;
+    float px = x - padding_l;
+    float py = y - padding_t;
+    float p = clamp(fx_age / REZ_T, 0.0, 1.0);
+    p = 1.0 - (1.0 - p) * (1.0 - p);
+
+    float block = rez_hash(floor(vec2(px, py) / 14.0));
+    float front = p * 1.25 - 0.12 * block;
+    float d = front - py / max(h, 1.0);
+
+    vec3 cyan = vec3(0.10, 0.85, 1.0);
+    if(d < 0.0){
+        /* Not yet rezzed: wireframe grid and outline */
+        float gx = abs(mod(px, 32.0) - 16.0);
+        float gy = abs(mod(py, 32.0) - 16.0);
+        float line = step(15.0, max(gx, gy));
+        float edge = step(min(min(px, w - px), min(py, h - py)), 2.0);
+        float a = (0.18 * line + 0.8 * edge) * (1.0 - p) * smoothstep(-0.6, 0.0, d);
+        return vec4(cyan * a, a) * alpha;
+    }
+    /* Scan front glows, contents settle from cyan tint */
+    float glow = exp(-d * 40.0);
+    float tint = exp(-d * 8.0) * (1.0 - p);
+    vec3 col = mix(c.rgb, cyan * c.a, 0.6 * tint) + cyan * glow * 0.9;
+    return vec4(col, max(c.a, glow * 0.9 * alpha));
+}
+
+void main() {
+    float x = (v_texcoord.x - offset_x)*scale_x;
+    float y = (v_texcoord.y - offset_y)*scale_y;
+
+    if(x < padding_l) discard;
+    if(y < padding_t) discard;
+    if(x > width - padding_r) discard;
+    if(y > height - padding_b) discard;
+    if(x < cornerradius + padding_l && y < cornerradius + padding_t){
+        if(length(vec2(x, y) -
+                vec2(cornerradius + padding_l, cornerradius + padding_t)) > cornerradius)
+            discard;
+    }
+    if(x > width - cornerradius - padding_r && y < cornerradius + padding_t){
+        if(length(vec2(x, y) -
+                vec2(width - cornerradius - padding_r, cornerradius + padding_t)) > cornerradius)
+            discard;
+    }
+    if(x < cornerradius + padding_l && y > height - cornerradius - padding_b){
+        if(length(vec2(x, y) -
+                vec2(cornerradius + padding_l, height - cornerradius - padding_b)) > cornerradius)
+            discard;
+    }
+    if(x > width - cornerradius - padding_r && y > height - cornerradius - padding_b){
+        if(length(vec2(x, y) - 
+                    vec2(width - cornerradius - padding_r, height - cornerradius - padding_b)) > cornerradius)
+            discard;
+    }
+
+    gl_FragColor = rez(texture2D(texture0, v_texcoord) * alpha, x, y);
+};
diff --git a/src/wm/shaders/texture/tron/fragment_rgba.glsl b/src/wm/shaders/texture/tron/fragment_rgba.glsl
new file mode 100644
index 0000000..c41f5b6
--- /dev/null
+++ b/src/wm/shaders/texture/tron/fragment_rgba.glsl
@@ -0,0 +1,92 @@
+precision mediump float;
+
+varying vec2 v_texcoord;
+uniform sampler2D tex;
+uniform float alpha;
+
+uniform float offset_x;
+uniform float offset_y;
+uniform float scale_x;
+uniform float scale_y;
+uniform float width;
+uniform float height;
+
+uniform float padding_l;
+uniform float padding_t;
+uniform float padding_r;
+uniform float padding_b;
+uniform float cornerradius;
+uniform float lock_perc;
+
+uniform float time;
+uniform float fx_age;
+
+/* Rez-in: a cyan scan front sweeps down the window, leaving a wireframe
+ * construct ahead of it and the real contents behind it. */
+const float REZ_T = 0.45;
+
+float rez_hash(vec2 p){
+    return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453);
+}
+
+vec4 rez(vec4 c, float x, float y){
+    if(fx_age >= REZ_T) return c;
+    float w = width - padding_l - padding_r;
+    float h = height - padding_t - padding_b;
+    float px = x - padding_l;
+    float py = y - padding_t;
+    float p = clamp(fx_age / REZ_T, 0.0, 1.0);
+    p = 1.0 - (1.0 - p) * (1.0 - p);
+
+    float block = rez_hash(floor(vec2(px, py) / 14.0));
+    float front = p * 1.25 - 0.12 * block;
+    float d = front - py / max(h, 1.0);
+
+    vec3 cyan = vec3(0.10, 0.85, 1.0);
+    if(d < 0.0){
+        /* Not yet rezzed: wireframe grid and outline */
+        float gx = abs(mod(px, 32.0) - 16.0);
+        float gy = abs(mod(py, 32.0) - 16.0);
+        float line = step(15.0, max(gx, gy));
+        float edge = step(min(min(px, w - px), min(py, h - py)), 2.0);
+        float a = (0.18 * line + 0.8 * edge) * (1.0 - p) * smoothstep(-0.6, 0.0, d);
+        return vec4(cyan * a, a) * alpha;
+    }
+    /* Scan front glows, contents settle from cyan tint */
+    float glow = exp(-d * 40.0);
+    float tint = exp(-d * 8.0) * (1.0 - p);
+    vec3 col = mix(c.rgb, cyan * c.a, 0.6 * tint) + cyan * glow * 0.9;
+    return vec4(col, max(c.a, glow * 0.9 * alpha));
+}
+
+void main() {
+    float x = (v_texcoord.x - offset_x)*scale_x;
+    float y = (v_texcoord.y - offset_y)*scale_y;
+
+    if(x < padding_l) discard;
+    if(y < padding_t) discard;
+    if(x > width - padding_r) discard;
+    if(y > height - padding_b) discard;
+    if(x < cornerradius + padding_l && y < cornerradius + padding_t){
+        if(length(vec2(x, y) -
+                vec2(cornerradius + padding_l, cornerradius + padding_t)) > cornerradius)
+            discard;
+    }
+    if(x > width - cornerradius - padding_r && y < cornerradius + padding_t){
+        if(length(vec2(x, y) -
+                vec2(width - cornerradius - padding_r, cornerradius + padding_t)) > cornerradius)
+            discard;
+    }
+    if(x < cornerradius + padding_l && y > height - cornerradius - padding_b){
+        if(length(vec2(x, y) -
+                vec2(cornerradius + padding_l, height - cornerradius - padding_b)) > cornerradius)
+            discard;
+    }
+    if(x > width - cornerradius - padding_r && y > height - cornerradius - padding_b){
+        if(length(vec2(x, y) - 
+                    vec2(width - cornerradius - padding_r, height - cornerradius - padding_b)) > cornerradius)
+            discard;
+    }
+
+    gl_FragColor = rez(texture2D(tex, v_texcoord) * alpha, x, y);
+}

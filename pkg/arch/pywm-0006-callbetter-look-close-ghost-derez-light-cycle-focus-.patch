diff --git a/src/wm/wm_ghost.c b/src/wm/wm_ghost.c
new file mode 100644
index 0000000..a0ebca8
--- /dev/null
+++ b/src/wm/wm_ghost.c
@@ -0,0 +1,214 @@
+#define _POSIX_C_SOURCE 200809L
+
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+#include <math.h>
+#include <time.h>
+#include <wlr/util/log.h>
+
+#include "wm/wm_ghost.h"
+#include "wm/wm_view.h"
+#include "wm/wm_server.h"
+#include "wm/wm_output.h"
+#include "wm/wm_layout.h"
+#include "wm/wm_renderer.h"
+#include "wm/wm_config.h"
+#include "wm/wm_util.h"
+
+/* Seconds the ghost stays; the shader decides what it looks like meanwhile */
+#define WM_GHOST_DURATION 0.6
+
+struct wm_content_vtable wm_ghost_vtable;
+
+static double age_of(struct wm_ghost* ghost, struct timespec now){
+    return (now.tv_sec - ghost->start.tv_sec) + (now.tv_nsec - ghost->start.tv_nsec) / 1e9;
+}
+
+static int timer_handler(void* data){
+    struct wm_ghost* ghost = data;
+    struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+
+    wm_layout_damage_from(ghost->super.wm_server->wm_layout, &ghost->super, NULL);
+    if(age_of(ghost, now) > WM_GHOST_DURATION){
+        wm_content_destroy(&ghost->super);
+        return 0;
+    }
+
+    int fps = ghost->super.wm_server->wm_config->anim_fps;
+    int ms = fps > 0 ? 1000 / fps : 16;
+    wl_event_source_timer_update(ghost->timer, ms < 8 ? 8 : ms);
+    return 0;
+}
+
+static void wm_ghost_destroy(struct wm_content* super){
+    struct wm_ghost* ghost = wm_cast(wm_ghost, super);
+    if(ghost->timer) wl_event_source_remove(ghost->timer);
+#ifdef WM_CUSTOM_RENDERER
+    wm_renderer_delete_texture(super->wm_server->wm_renderer, ghost->tex);
+#endif
+    wm_content_base_destroy(super);
+    free(ghost);
+}
+
+static void wm_ghost_render(struct wm_content* super, struct wm_output* output, pixman_region32_t* output_damage, struct timespec now){
+#ifdef WM_CUSTOM_RENDERER
+    struct wm_ghost* ghost = wm_cast(wm_ghost, super);
+    if(output != ghost->output) return;
+    double age = age_of(ghost, now);
+    if(age > WM_GHOST_DURATION) return;
+
+    double display_x, display_y, display_width, display_height;
+    wm_content_get_box(super, &display_x, &display_y, &display_width, &display_height);
+    double mask_x, mask_y, mask_w, mask_h;
+    wm_content_get_mask(super, &mask_x, &mask_y, &mask_w, &mask_h);
+    double s = output->wlr_output->scale;
+
+    struct wlr_box box = {
+        .x = round((display_x - output->layout_x) * s),
+        .y = round((display_y - output->layout_y) * s),
+        .width = round(display_width * s),
+        .height = round(display_height * s)};
+    struct wlr_box mask = {
+        .x = round((display_x - output->layout_x + mask_x) * s),
+        .y = round((display_y - output->layout_y + mask_y) * s),
+        .width = round(mask_w * s),
+        .height = round(mask_h * s)};
+
+    struct wm_renderer* renderer = super->wm_server->wm_renderer;
+    struct wm_renderer_texture_shaders* saved = renderer->texture_shaders_selected;
+    renderer->texture_shaders_selected = ghost->shaders;
+    renderer->fx_age = age;
+    wm_renderer_render_gl_texture_at(renderer, output_damage, ghost->tex, ghost->tex_w, ghost->tex_h, &box,
+            wm_content_get_opacity(super), &mask, wm_content_get_corner_radius(super) * s,
+            super->lock_enabled ? 0.0 : super->wm_server->lock_perc);
+    renderer->fx_age = 1000.f;
+    renderer->texture_shaders_selected = saved;
+#endif
+}
+
+static void wm_ghost_printf(FILE* file, struct wm_content* super){
+    struct wm_ghost* ghost = wm_cast(wm_ghost, super);
+    fprintf(file, "wm_ghost (%f, %f - %f, %f)\n", super->display_x, super->display_y, super->display_width, super->display_height);
+    (void)ghost;
+}
+
+struct wm_content_vtable wm_ghost_vtable = {
+    .destroy = &wm_ghost_destroy,
+    .render = &wm_ghost_render,
+    .damage_output = NULL,
+    .printf = &wm_ghost_printf
+};
+
+#ifdef WM_CUSTOM_RENDERER
+static struct wm_renderer_texture_shaders* out_shaders(struct wm_server* server){
+    char name[WM_CONFIG_STRLEN + 8];
+    snprintf(name, sizeof(name), "%s_out", server->wm_config->texture_shaders);
+    return wm_renderer_find_texture_shaders(server->wm_renderer, name);
+}
+
+/* The output showing the centre of the view (first output as fallback) */
+static struct wm_output* output_of(struct wm_view* view){
+    double dx, dy, dw, dh;
+    wm_content_get_box(&view->super, &dx, &dy, &dw, &dh);
+    double cx = dx + dw / 2., cy = dy + dh / 2.;
+    struct wm_output* first = NULL;
+    struct wm_output* o;
+    wl_list_for_each(o, &view->super.wm_server->wm_layout->wm_outputs, link){
+        if(!first) first = o;
+        double w = o->wlr_output->width / o->wlr_output->scale;
+        double h = o->wlr_output->height / o->wlr_output->scale;
+        if(cx >= o->layout_x && cx < o->layout_x + w && cy >= o->layout_y && cy < o->layout_y + h) return o;
+    }
+    return first;
+}
+#endif
+
+void wm_ghost_drop_prepared(struct wm_view* view){
+#ifdef WM_CUSTOM_RENDERER
+    if(view->ghost_tex){
+        wm_renderer_delete_texture(view->super.wm_server->wm_renderer, view->ghost_tex);
+    }
+#endif
+    view->ghost_tex = 0;
+}
+
+void wm_ghost_prepare(struct wm_view* view){
+#ifdef WM_CUSTOM_RENDERER
+    struct wm_server* server = view->super.wm_server;
+    if(!view->mapped || !out_shaders(server)) return;
+    struct wm_output* output = output_of(view);
+    if(!output) return;
+    wm_ghost_drop_prepared(view);
+    int w = 0, h = 0;
+    view->ghost_tex = wm_renderer_snapshot_view(server->wm_renderer, view, output, &w, &h);
+    view->ghost_w = w;
+    view->ghost_h = h;
+    clock_gettime(CLOCK_MONOTONIC, &view->ghost_at);
+#endif
+}
+
+void wm_ghost_from_view(struct wm_view* view){
+#ifdef WM_CUSTOM_RENDERER
+    struct wm_server* server = view->super.wm_server;
+    struct wm_renderer_texture_shaders* shaders = out_shaders(server);
+    struct wm_output* output = output_of(view);
+    if(!view->mapped || !shaders || !output || wm_content_get_opacity(&view->super) < 0.01){
+        wm_ghost_drop_prepared(view);
+        return;
+    }
+
+    struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+
+    unsigned int tex = 0;
+    int w = 0, h = 0;
+    double prepared_age = (now.tv_sec - view->ghost_at.tv_sec) + (now.tv_nsec - view->ghost_at.tv_nsec) / 1e9;
+    if(view->ghost_tex && prepared_age < 0.5){
+        /* snapshot taken when the client dropped its buffer */
+        tex = view->ghost_tex;
+        w = view->ghost_w;
+        h = view->ghost_h;
+        view->ghost_tex = 0;
+    }else{
+        wm_ghost_drop_prepared(view);
+        tex = wm_renderer_snapshot_view(server->wm_renderer, view, output, &w, &h);
+    }
+    if(!tex) return;
+
+    struct wm_ghost* ghost = calloc(1, sizeof(struct wm_ghost));
+    wm_content_init(&ghost->super, server);
+    ghost->super.vtable = &wm_ghost_vtable;
+    ghost->tex = tex;
+    ghost->tex_w = w;
+    ghost->tex_h = h;
+    ghost->output = output;
+    ghost->shaders = shaders;
+    ghost->start = now;
+
+    /* Same place, mask, rounding, depth and workspace as the window had */
+    struct wm_content* c = &view->super;
+    ghost->super.display_x = c->display_x;
+    ghost->super.display_y = c->display_y;
+    ghost->super.display_width = c->display_width;
+    ghost->super.display_height = c->display_height;
+    ghost->super.fixed_output = c->fixed_output;
+    ghost->super.workspace_x = c->workspace_x;
+    ghost->super.workspace_y = c->workspace_y;
+    ghost->super.workspace_width = c->workspace_width;
+    ghost->super.workspace_height = c->workspace_height;
+    ghost->super.mask_x = c->mask_x;
+    ghost->super.mask_y = c->mask_y;
+    ghost->super.mask_w = c->mask_w;
+    ghost->super.mask_h = c->mask_h;
+    ghost->super.corner_radius = c->corner_radius;
+    ghost->super.z_index = c->z_index;
+    ghost->super.opacity = c->opacity;
+    ghost->super.lock_enabled = c->lock_enabled;
+
+    ghost->timer = wl_event_loop_add_timer(server->wl_event_loop, timer_handler, ghost);
+    if(ghost->timer) wl_event_source_timer_update(ghost->timer, 8);
+    wm_layout_damage_from(server->wm_layout, &ghost->super, NULL);
+#endif
+}

diff --git a/src/wm/shaders/primitive/tron_cb_cycle/fragment.glsl b/src/wm/shaders/primitive/tron_cb_cycle/fragment.glsl
new file mode 100644
index 0000000..355f853
--- /dev/null
+++ b/src/wm/shaders/primitive/tron_cb_cycle/fragment.glsl
@@ -0,0 +1,97 @@
+precision highp float;
+/*
+ * Light cycle that rides from the old focused window to the new one on a
+ * focus change: a packet on a three-segment right-angle path through the
+ * gap, with a fading trail, drawn like the light cycles of callbetter.com.
+ *
+ * 0-7   path points p0..p3, widget-local px
+ * 8-10  colour (r, g, b)
+ * 11    start time (same clock as time)
+ * 12    travel time (s)
+ * 13    output scale
+ */
+uniform float params_float[14];
+uniform float alpha;
+uniform float time;
+varying vec2 v_texcoord;
+
+uniform float width;
+uniform float height;
+
+const vec3 HOT = vec3(224.0, 251.0, 255.0) / 255.0;
+
+/* Distance to segment ab and the position along it (0..1) */
+vec2 seg(vec2 p, vec2 a, vec2 b){
+    vec2 ab = b - a;
+    float t = clamp(dot(p - a, ab) / max(dot(ab, ab), 1e-4), 0.0, 1.0);
+    return vec2(length(p - (a + ab * t)), t);
+}
+
+void main() {
+    float sc = max(params_float[13], 0.1);
+    vec2 p = v_texcoord * vec2(width, height);
+    vec2 P0 = vec2(params_float[0], params_float[1]);
+    vec2 P1 = vec2(params_float[2], params_float[3]);
+    vec2 P2 = vec2(params_float[4], params_float[5]);
+    vec2 P3 = vec2(params_float[6], params_float[7]);
+    vec3 pc = vec3(params_float[8], params_float[9], params_float[10]);
+    float T = max(params_float[12], 0.01);
+
+    float L1 = length(P1 - P0);
+    float L2 = length(P2 - P1);
+    float L3 = length(P3 - P2);
+    float total = max(L1 + L2 + L3, 1.0);
+
+    float age = mod(time - params_float[11] + 3600.0, 3600.0);
+    float FADE = 0.35;
+    if(age > T + FADE){
+        discard;
+    }
+    float pr = clamp(age / T, 0.0, 1.0);
+    pr = pr * pr * (3.0 - 2.0 * pr);
+    float head = pr * total;
+    /* The tail keeps catching up after arrival, then everything fades */
+    float tail = max(0.8 * total, 160.0 * sc) * (1.0 - smoothstep(T, T + FADE, age));
+    float fade = 1.0 - smoothstep(T + 0.5 * FADE, T + FADE, age);
+
+    float glow = 0.0;
+    float core = 0.0;
+    vec2 d;
+    float behind;
+    float al;
+
+    d = seg(p, P0, P1);
+    behind = head - d.y * L1;
+    al = step(0.0, behind) * max(1.0 - behind / max(tail, 1e-3), 0.0);
+    glow = max(glow, al * 0.3 * exp(-d.x / (3.0 * sc)));
+    core = max(core, al * 0.9 * (1.0 - smoothstep(0.75 * sc, 0.75 * sc + 1.0, d.x)));
+
+    d = seg(p, P1, P2);
+    behind = head - (L1 + d.y * L2);
+    al = step(0.0, behind) * max(1.0 - behind / max(tail, 1e-3), 0.0);
+    glow = max(glow, al * 0.3 * exp(-d.x / (3.0 * sc)));
+    core = max(core, al * 0.9 * (1.0 - smoothstep(0.75 * sc, 0.75 * sc + 1.0, d.x)));
+
+    d = seg(p, P2, P3);
+    behind = head - (L1 + L2 + d.y * L3);
+    al = step(0.0, behind) * max(1.0 - behind / max(tail, 1e-3), 0.0);
+    glow = max(glow, al * 0.3 * exp(-d.x / (3.0 * sc)));
+    core = max(core, al * 0.9 * (1.0 - smoothstep(0.75 * sc, 0.75 * sc + 1.0, d.x)));
+
+    /* Packet: soft halo and a white-hot dot at the head */
+    vec2 hp;
+    if(head <= L1){
+        hp = P0 + (P1 - P0) * (head / max(L1, 1e-3));
+    }else if(head <= L1 + L2){
+        hp = P1 + (P2 - P1) * ((head - L1) / max(L2, 1e-3));
+    }else{
+        hp = P2 + (P3 - P2) * ((head - L1 - L2) / max(L3, 1e-3));
+    }
+    float hd = length(p - hp);
+    float hg = 0.35 * (1.0 - smoothstep(6.5 * sc, 7.5 * sc, hd));
+    float hc = 0.95 * (1.0 - smoothstep(1.7 * sc, 2.7 * sc, hd));
+
+    vec3 pm = pc * (glow + core + hg) + HOT * hc;
+    float a = clamp(glow + core + hg + hc, 0.0, 1.0) * fade;
+    gl_FragColor = vec4(clamp(pm * fade, 0.0, 1.0), a) * alpha;
+}

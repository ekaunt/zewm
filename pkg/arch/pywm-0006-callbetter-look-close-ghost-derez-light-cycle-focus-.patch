+varying vec2 v_texcoord;
+uniform sampler2D tex;
+uniform float alpha;
+
+uniform float offset_x;
+uniform float offset_y;
+uniform float scale_x;
+uniform float scale_y;
+uniform float width;
+uniform float height;
+
+uniform float padding_l;
+uniform float padding_t;
+uniform float padding_r;
+uniform float padding_b;
+uniform float cornerradius;
+uniform float lock_perc;
+
+uniform float time;
+uniform float fx_age;
+
+/* Tron Legacy derez. Drawn on the snapshot of a window after it closed
+ * (fx_age: seconds since). The window pixelates into cells that light up
+ * cyan, break away from the centre outwards, fall and dissolve. */
+const float DUR = 0.55;
+const float CELL = 14.0;
+const vec3 CY = vec3(0.133, 0.827, 0.933);
+const vec3 HOT = vec3(0.878, 0.984, 1.0);
+
+float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
+
+vec4 sample_px(vec2 q){
+    return texture2D(tex, vec2(q.x / scale_x + offset_x, q.y / scale_y + offset_y));
+}
+
+void main() {
+    float x = (v_texcoord.x - offset_x)*scale_x;
+    float y = (v_texcoord.y - offset_y)*scale_y;
+
+    if(x < padding_l) discard;
+    if(y < padding_t) discard;
+    if(x > width - padding_r) discard;
+    if(y > height - padding_b) discard;
+    if(x < cornerradius + padding_l && y < cornerradius + padding_t){
+        if(length(vec2(x, y) - vec2(cornerradius + padding_l, cornerradius + padding_t)) > cornerradius) discard;
+    }
+    if(x > width - cornerradius - padding_r && y < cornerradius + padding_t){
+        if(length(vec2(x, y) - vec2(width - cornerradius - padding_r, cornerradius + padding_t)) > cornerradius) discard;
+    }
+    if(x < cornerradius + padding_l && y > height - cornerradius - padding_b){
+        if(length(vec2(x, y) - vec2(cornerradius + padding_l, height - cornerradius - padding_b)) > cornerradius) discard;
+    }
+    if(x > width - cornerradius - padding_r && y > height - cornerradius - padding_b){
+        if(length(vec2(x, y) - vec2(width - cornerradius - padding_r, height - cornerradius - padding_b)) > cornerradius) discard;
+    }
+
+    vec2 p = vec2(x, y);
+    vec2 in0 = vec2(padding_l, padding_t);
+    vec2 size = vec2(width - padding_r, height - padding_b) - in0;
+    float t = clamp(fx_age / DUR, 0.0, 1.0);
+    vec2 c0 = floor((p - in0) / CELL);
+
+    /* Cells fall, so this pixel may show its own cell or one from above */
+    vec4 col = vec4(0.0);
+    bool hit = false;
+    for(int k = 0; k < 9; k++){
+        vec2 ci = c0 - vec2(0.0, float(k));
+        if(ci.y < 0.0) break;
+        vec2 cc = in0 + (ci + 0.5) * CELL;
+        float h = hash(ci + 0.37);
+        float h2 = hash(ci * 1.7 + 9.1);
+        /* break time: from the centre outwards, with some noise */
+        float d = length((cc - in0 - 0.5 * size) / (0.5 * size + 1.0));
+        float tb = 0.10 + 0.30 * d + 0.18 * h;
+        float a = t - tb;
+        vec2 disp = vec2(0.0);
+        float s = 1.0;
+        if(a > 0.0){
+            float ar = a * DUR;
+            disp = vec2((h2 - 0.5) * 40.0 * ar, (60.0 + 90.0 * h) * ar + 1000.0 * ar * ar);
+            s = 1.0 - a / 0.45;
+        }
+        if(s <= 0.0) continue;
+        vec2 rel = (p - disp - cc) / (0.5 * CELL * s);
+        if(abs(rel.x) > 1.0 || abs(rel.y) > 1.0) continue;
+
+        /* pixelate as the cell is about to break, light its rim, tint it */
+        vec2 src = cc + rel * 0.5 * CELL;
+        float mosaic = smoothstep(tb - 0.14, tb - 0.02, t);
+        vec4 c = mix(sample_px(src), sample_px(cc), mosaic);
+        float lit = smoothstep(tb - 0.10, tb + 0.04, t);
+        float rim = smoothstep(0.72, 1.0, max(abs(rel.x), abs(rel.y))) * lit;
+        float fade = s;
+        vec3 rgb = mix(c.rgb, CY * c.a, 0.4 * lit) * fade;
+        rgb += CY * rim * 0.9 * fade;
+        rgb += HOT * rim * 0.4 * fade * smoothstep(0.0, 0.1, a);
+        col = vec4(rgb, max(c.a * fade, rim * fade));
+        hit = true;
+        break;
+    }
+    if(!hit) discard;
+
+    /* the flash when the program is cut */
+    col.rgb += CY * 0.5 * (1.0 - smoothstep(0.0, 0.08, t)) * col.a;
+    gl_FragColor = col * alpha;
+}

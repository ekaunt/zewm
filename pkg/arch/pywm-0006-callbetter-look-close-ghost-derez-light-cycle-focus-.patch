     float line = 1.0 - smoothstep(0.5 * sc, 0.5 * sc + 1.0, dist);
     float glow = exp(-max(sd, 0.0) / max(params_float[6], 0.1)) * step(0.0, sd);
-    float a = 0.45 * line + 0.10 * glow;

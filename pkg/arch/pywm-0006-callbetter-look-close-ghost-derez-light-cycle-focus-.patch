+    float fc = min(mod(cp - head + 0.5 * perim, perim), mod(cp - head, perim)) / max(0.5 * perim, 1.0);
+    float tc = T * (1.0 - pow(max(1.0 - fc, 0.0), 1.0 / 3.0));

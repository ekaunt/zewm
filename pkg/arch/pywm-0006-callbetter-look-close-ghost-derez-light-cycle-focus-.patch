+uniform float params_float[15];
 uniform float alpha;
 uniform float time;
 varying vec2 v_texcoord;
@@ -43,6 +48,29 @@ float perimeter_pos(vec2 p, float a, float b, float r){
     return p.x > 0.0 ? 2.0 * a + lq + (p.y + b) : 4.0 * a + 2.0 * b + 3.0 * lq + (b - p.y);
 }
 
+/* Brightness of a streak whose head is delta px ahead (delta > 0: behind the head) */
+vec2 streak(float delta, float perim){
+    float tail = 0.35 * perim;
+    float behind = max(delta, 0.0);
+    float ahead = max(-delta, 0.0);
+    float body = exp(-3.0 * behind / tail) * (1.0 - smoothstep(tail, 0.5 * perim, behind)) * exp(-ahead / 3.0);
+    float head = exp(-abs(delta) / 8.0);
+    return vec2(body, head);
+}
+
+/* tbflick keyframes: 0 0, 9% 1, 12% .15, 18% 1, 24% .4, 30% 1, 42% .75, 50% 1 */
+float flick(float x){
+    if(x <= 0.0) return 0.0;
+    if(x < 0.09) return x / 0.09;
+    if(x < 0.12) return mix(1.0, 0.15, (x - 0.09) / 0.03);
+    if(x < 0.18) return mix(0.15, 1.0, (x - 0.12) / 0.06);
+    if(x < 0.24) return mix(1.0, 0.4, (x - 0.18) / 0.06);
+    if(x < 0.30) return mix(0.4, 1.0, (x - 0.24) / 0.06);
+    if(x < 0.42) return mix(1.0, 0.75, (x - 0.30) / 0.12);
+    if(x < 0.50) return mix(0.75, 1.0, (x - 0.42) / 0.08);
+    return 1.0;
+}
+

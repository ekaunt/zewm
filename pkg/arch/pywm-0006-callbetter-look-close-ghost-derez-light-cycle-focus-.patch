index 0000000..bbf18cb
--- /dev/null
+++ b/include/wm/wm_ghost.h
@@ -0,0 +1,38 @@
+#ifndef WM_GHOST_H
+#define WM_GHOST_H
+
+#include <time.h>
+#include <wayland-server.h>
+
+#include "wm_content.h"
+
+struct wm_view;
+struct wm_output;
+struct wm_renderer_texture_shaders;
+
+/*
+ * Snapshot of a window that just closed, drawn for a short while with the
+ * "<texture_shaders>_out" shader set (e.g. cb_out: derez). Purely compositor
+ * side; the python layout never sees it.
+ */
+struct wm_ghost {
+    struct wm_content super;
+
+    unsigned int tex;
+    int tex_w;
+    int tex_h;
+    struct wm_output* output;
+    struct wm_renderer_texture_shaders* shaders;
+
+    struct timespec start;
+    struct wl_event_source* timer;
+};
+
+/* Call from the view's unmap handler, before mapped is cleared */
+void wm_ghost_from_view(struct wm_view* view);
+
+/* The client is about to drop its buffer: snapshot now, the unmap uses it */
+void wm_ghost_prepare(struct wm_view* view);
+void wm_ghost_drop_prepared(struct wm_view* view);
+
+#endif

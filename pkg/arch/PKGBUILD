pkgver() {
	cd "$srcdir/$_pkgname"
	printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
	cd "$srcdir/pywm-next"
	git submodule update --init --recursive
	# newer libinput has switch types this wlroots doesn't handle
	patch -d subprojects/wlroots -p1 < "$srcdir/wlroots-switch-default.patch"
	# zewm's own pywm-next work (tron look, derez ghost, light cycle), in order;
	# regenerate with: git -C pywm-next format-patch <base>..tron
	for p in "$srcdir"/pywm-*.patch; do
		patch -Np1 < "$p"
	done
}

build() {
	cd "$srcdir/pywm-next"
	python setup.py build
	cd "$srcdir/$_pkgname"
	python setup.py build
}

package() {
	cd "$srcdir/pywm-next"
	python setup.py install --root="$pkgdir" --optimize=1
	cd "$srcdir/$_pkgname"
	python setup.py install --root="$pkgdir" --optimize=1
	install -Dm644 newm/resources/newm.desktop "$pkgdir/usr/share/wayland-sessions/zewm.desktop"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

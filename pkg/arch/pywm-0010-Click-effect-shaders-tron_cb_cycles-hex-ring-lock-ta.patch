diff --git a/src/wm/shaders/primitive/tron_cb_tap/fragment.glsl b/src/wm/shaders/primitive/tron_cb_tap/fragment.glsl
new file mode 100644
index 0000000..7b55b73
--- /dev/null
+++ b/src/wm/shaders/primitive/tron_cb_tap/fragment.glsl
@@ -0,0 +1,107 @@
+precision highp float;
+/*
+ * Click burst, drawn for 1 s after a button press: four light cycles leave
+ * the grid intersection nearest the pointer along the background grid
+ * lines, cyan and orange alternating, turning 90 degrees at crossings now
+ * and then, exactly like the cycles of tron_cb_grid.
+ *
+ * 0    time of the press (same clock as time); also seeds turns and speeds
+ * 1    output scale (px per logical px)
+ * 2-3  widget origin in output logical px
+ * 4-5  grid shift (tron_cb_grid params 1-2)
+ * 6    grid zoom (tron_cb_grid param 6)
+ * 7-8  output size in logical px
+ */
+uniform float params_float[9];
+uniform float alpha;
+uniform float time;
+varying vec2 v_texcoord;
+
+uniform float width;
+uniform float height;
+
+const float T = 1.0;
+const float CELL = 48.0;
+const vec3 OR = vec3(0.976, 0.451, 0.086);
+const vec3 CY = vec3(0.133, 0.827, 0.933);
+const vec3 HOT = vec3(0.878, 0.984, 1.0);
+
+float hash1(float n){ return fract(sin(n * 127.1) * 43758.5453); }
+
+vec2 seg(vec2 p, vec2 a, vec2 b){
+    vec2 ab = b - a;
+    float t = clamp(dot(p - a, ab) / max(dot(ab, ab), 1e-4), 0.0, 1.0);
+    return vec2(length(p - (a + ab * t)), t);
+}
+
+void main() {
+    float sc = max(params_float[1], 0.1);
+    float age = mod(time - params_float[0] + 3600.0, 3600.0);
+    if(age > T) discard;
+
+    /* Same grid space as tron_cb_grid: output logical px, zoomed about the
+       output centre, then shifted */
+    vec2 S = vec2(params_float[7], params_float[8]);
+    vec2 C = 0.5 * S;
+    float zg = max(params_float[6], 0.05);
+    vec2 shift = vec2(params_float[4], params_float[5]);
+    vec2 origin = vec2(params_float[2], params_float[3]);
+    vec2 q = origin + v_texcoord * vec2(width, height) / sc;
+    vec2 g = (q - C) / zg + C + shift;
+    vec2 qc = origin + 0.5 * vec2(width, height) / sc;
+    vec2 gc = (qc - C) / zg + C + shift;
+    float x0 = mod(S.x * 0.5, CELL) + 0.5;
+    /* nearest grid intersection to the press */
+    vec2 start = vec2(x0 + CELL * floor((gc.x - x0) / CELL + 0.5), 0.5 + CELL * floor((gc.y - 0.5) / CELL + 0.5));
+
+    float seed = floor(params_float[0] * 97.0);
+    float fade = 1.0 - smoothstep(0.7, 1.0, age / T);
+    vec3 col = vec3(0.0);
+    float a = 0.0;
+    for(int i = 0; i < 4; i++){
+        float fi = float(i);
+        vec2 d = i == 0 ? vec2(1.0, 0.0) : (i == 1 ? vec2(0.0, 1.0) : (i == 2 ? vec2(-1.0, 0.0) : vec2(0.0, -1.0)));
+        float spd = (150.0 + 140.0 * hash1(seed + fi * 3.19 + 0.37)) / zg;
+        float dist = min(spd * age, 260.0 / zg);
+        float tail = spd * 0.8;
+        vec2 pos = start;
+        float travelled = 0.0;
+        float glow = 0.0;
+        float core = 0.0;
+        for(int k = 0; k < 8; k++){
+            float fk = float(k);
+            /* crossings before a turn: each crossing turns with p = 0.3, like the site */
+            float u = max(hash1(seed + fi * 8.9 + fk * 1.31 + 0.97), 1e-4);
+            float n = 1.0 + floor(log(u) / log(0.7));
+            float l = min(n * CELL, dist - travelled);
+            if(l <= 0.0) break;
+            vec2 b = pos + d * l;
+            vec2 s = seg(g, pos, b);
+            float along = travelled + s.y * l;
+            float pa = (dist - along) / tail;
+            float al = (1.0 - pa) * step(pa, 1.0) * fade;
+            float dx = s.x * zg;
+            glow = max(glow, al * 0.22 * (1.0 - smoothstep(2.0, 3.0, dx)));
+            core = max(core, al * 0.9 * (1.0 - smoothstep(0.5, 1.25, dx)));
+            travelled += l;
+            pos = b;
+            float tr = hash1(seed + fi * 9.7 + fk * 2.3 + 0.13);
+            d = vec2(-d.y, d.x) * (tr < 0.5 ? 1.0 : -1.0);
+        }
+        float hd = length(g - pos) * zg;
+        float hg = 0.3 * fade * (1.0 - smoothstep(6.5, 7.5, hd));
+        float hc = 0.95 * fade * (1.0 - smoothstep(1.7, 2.7, hd));
+        vec3 c = mod(fi, 2.0) < 0.5 ? CY : OR;
+        col += c * (glow + core + hg) + HOT * hc;
+        a += glow + core + hg + hc;
+    }
+
+    /* the intersection lights up at the press and settles */
+    float r0 = length(g - start) * zg;
+    float spark = (1.0 - smoothstep(2.0, 4.0, r0)) * (1.0 - smoothstep(0.0, 0.25, age));
+    float spark_glow = exp(-r0 / 8.0) * 0.5 * (1.0 - smoothstep(0.0, 0.4, age));
+    col += HOT * spark + CY * spark_glow;
+    a += spark + spark_glow;
+
+    gl_FragColor = vec4(min(col, vec3(1.0)), clamp(a, 0.0, 1.0)) * alpha;
+}

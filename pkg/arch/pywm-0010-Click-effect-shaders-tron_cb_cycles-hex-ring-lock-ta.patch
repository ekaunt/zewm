diff --git a/src/wm/shaders/primitive/tron_cb_ring/fragment.glsl b/src/wm/shaders/primitive/tron_cb_ring/fragment.glsl
new file mode 100644
index 0000000..d000494
--- /dev/null
+++ b/src/wm/shaders/primitive/tron_cb_ring/fragment.glsl
@@ -0,0 +1,56 @@
+precision highp float;
+/*
+ * Click shockwave, drawn for 0.35 s after a button press: a thin hot-white
+ * ring with a coloured glow expands from the pointer and fades, like the
+ * tap ring of callbetter.com's demo cursor (curtap), with a soft fill
+ * trailing behind the front. A hot spark marks the press itself.
+ *
+ * 0    time of the press (same clock as time)
+ * 1    output scale (px per logical px)
+ * 2-4  ring colour (r, g, b)
+ */
+uniform float params_float[5];
+uniform float alpha;
+uniform float time;
+varying vec2 v_texcoord;
+
+uniform float width;
+uniform float height;
+
+const float T = 0.35;
+const float R0 = 4.0;       /* radius at the press (logical px) */
+const float R1 = 46.0;      /* radius at the end */
+const vec3 HOT = vec3(0.878, 0.984, 1.0);
+
+void main() {
+    float sc = max(params_float[1], 0.1);
+    float age = mod(time - params_float[0] + 3600.0, 3600.0);
+    if(age > T) discard;
+
+    vec2 p = (v_texcoord - 0.5) * vec2(width, height) / sc;
+    vec3 cb = vec3(params_float[2], params_float[3], params_float[4]);
+    float r = length(p);
+
+    float u = clamp(age / T, 0.0, 1.0);
+    float e = 1.0 - pow(1.0 - u, 3.0);           /* ease-out */
+    float rr = mix(R0, R1, e);
+    float fade = 1.0 - smoothstep(0.35, 1.0, u);  /* opacity .9 -> 0 */
+
+    float d = r - rr;
+    float ad = abs(d);
+    /* 1px hot core, coloured glow either side, fill trailing inside the front */
+    float core = (1.0 - smoothstep(0.5, 1.3, ad)) * fade;
+    float glow = exp(-ad / 3.5) * 0.55 * fade;
+    float trail = exp(max(-d, 0.0) / -10.0) * step(d, 0.0) * 0.18 * fade * (1.0 - e * 0.6);
+
+    vec3 col = HOT * core + cb * (glow + trail);
+    float a = core + glow + trail;
+
+    /* the press itself: a hot spark that settles fast */
+    float spark = (1.0 - smoothstep(1.5, 3.2, r)) * (1.0 - smoothstep(0.0, 0.15, age));
+    float spark_glow = exp(-r / 8.0) * 0.5 * (1.0 - smoothstep(0.0, 0.25, age));
+    col += HOT * spark + cb * spark_glow;
+    a += spark + spark_glow;
+
+    gl_FragColor = vec4(min(col, vec3(1.0)), clamp(a, 0.0, 1.0)) * alpha;
+}

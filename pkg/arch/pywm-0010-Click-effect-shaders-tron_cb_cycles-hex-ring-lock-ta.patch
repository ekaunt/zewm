diff --git a/src/wm/shaders/primitive/tron_cb_cycles/fragment.glsl b/src/wm/shaders/primitive/tron_cb_cycles/fragment.glsl
new file mode 100644
index 0000000..3627305
--- /dev/null
+++ b/src/wm/shaders/primitive/tron_cb_cycles/fragment.glsl
@@ -0,0 +1,77 @@
+precision highp float;
+/*
+ * Click light cycles, drawn for 0.2 s after a button press: four light
+ * cycles shoot out from the pointer the way the arrow cursor points, fanned 30 degrees
+ * apart around its axis. Each is a short hot-white head dragging a
+ * straight light trail that fades toward its tail, like the cycles riding
+ * the tron_cb_grid background.
+ *
+ * 0    time of the press (same clock as time)
+ * 1    output scale (px per logical px)
+ * 2-4  colour (r, g, b)
+ */
+uniform float params_float[5];
+uniform float alpha;
+uniform float time;
+varying vec2 v_texcoord;
+
+uniform float width;
+uniform float height;
+
+const float T = 0.2;
+const float FLY = 0.16;              /* time for a head to reach D1 */
+const float D0 = 2.0;                /* start distance from the hotspot (logical px) */
+const float D1 = 36.0;               /* end distance of the head */
+const float TAIL = 22.0;             /* trail length behind the head */
+const float BIKE = 6.0;              /* length of the hot head */
+const float BASE = 4.29001;          /* axis of the Bibata arrow cursor, tip-first (245.8 degrees, y down) */
+const float SPREAD = 0.52360;        /* 30 degrees between cycles */
+const vec3 HOT = vec3(0.878, 0.984, 1.0);
+
+float seg(vec2 p, vec2 a, vec2 b){
+    vec2 ab = b - a;
+    float t = clamp(dot(p - a, ab) / dot(ab, ab), 0.0, 1.0);
+    return length(p - (a + ab * t));
+}
+
+void main() {
+    float sc = max(params_float[1], 0.1);
+    float age = mod(time - params_float[0] + 3600.0, 3600.0);
+    if(age > T) discard;
+
+    vec2 p = (v_texcoord - 0.5) * vec2(width, height) / sc;
+    vec3 cb = vec3(params_float[2], params_float[3], params_float[4]);
+
+    float u = clamp(age / FLY, 0.0, 1.0);
+    float hd = mix(D0, D1, 1.0 - pow(1.0 - u, 2.0));
+    /* the trail keeps fading after the heads stop */
+    float bright = 1.0 - smoothstep(0.45, 1.0, age / T);
+
+    vec3 col = vec3(0.0);
+    float al = 0.0;
+    for(int i = 0; i < 4; i++){
+        float ang = BASE + (float(i) - 1.5) * SPREAD;
+        vec2 dir = vec2(cos(ang), sin(ang));
+        vec2 n = vec2(-dir.y, dir.x);
+        float along = dot(p, dir);
+        float perp = abs(dot(p, n));
+
+        /* light trail: from the tail (or the start) up to the head, brighter toward the head */
+        float t0 = max(D0, hd - TAIL);
+        float ramp = clamp((along - t0) / max(hd - t0, 1.0), 0.0, 1.0);
+        float inside = step(t0, along) * step(along, hd);
+        float tr = ramp * ramp * inside * bright;
+        float core = tr * (1.0 - smoothstep(0.5, 1.2, perp));
+        float glow = tr * exp(-perp / 2.2) * 0.45;
+
+        /* the cycle: a short hot bar at the head */
+        float hdist = seg(p, dir * (hd - BIKE), dir * hd);
+        float head = (1.0 - smoothstep(0.7, 1.5, hdist)) * bright;
+        float hglow = exp(-hdist / 3.0) * 0.6 * bright;
+
+        col += cb * (core * 0.8 + glow + hglow) + HOT * (core * 0.25 + head);
+        al += core + glow + head + hglow;
+    }
+
+    gl_FragColor = vec4(min(col, vec3(1.0)), clamp(al, 0.0, 1.0)) * alpha;
+}

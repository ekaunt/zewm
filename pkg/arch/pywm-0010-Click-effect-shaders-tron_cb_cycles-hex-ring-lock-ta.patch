diff --git a/src/wm/shaders/primitive/tron_cb_lock/fragment.glsl b/src/wm/shaders/primitive/tron_cb_lock/fragment.glsl
new file mode 100644
index 0000000..84445f2
--- /dev/null
+++ b/src/wm/shaders/primitive/tron_cb_lock/fragment.glsl
@@ -0,0 +1,117 @@
+precision highp float;
+/*
+ * Click target lock, drawn for half a second after a button press: four
+ * corner brackets snap in from outside onto the pointer (eased, with a
+ * small overshoot), flicker on like callbetter.com's tbflick, hold a beat
+ * and derez into scanline slices that drift outward. A hot spark marks
+ * the press itself.
+ *
+ * 0    time of the press (same clock as time); also seeds the derez
+ * 1    output scale (px per logical px)
+ * 2-4  bracket colour (r, g, b)
+ */
+uniform float params_float[5];
+uniform float alpha;
+uniform float time;
+varying vec2 v_texcoord;
+
+uniform float width;
+uniform float height;
+
+const float T = 0.5;        /* total */
+const float T_IN = 0.13;    /* fly-in */
+const float T_HOLD = 0.36;  /* derez begins */
+const float H0 = 64.0;      /* half-size at the start (logical px) */
+const float H1 = 15.0;      /* half-size once locked */
+const vec3 HOT = vec3(0.878, 0.984, 1.0);
+
+float hash1(float n){ return fract(sin(n * 127.1) * 43758.5453); }
+
+/* tbflick keyframes, started at the first full-on frame:
+   1, 12% .15, 18% 1, 24% .4, 30% 1, 42% .75, 50% 1 */
+float flick(float x){
+    if(x < 0.0) return 1.0;
+    if(x < 0.03) return mix(1.0, 0.15, x / 0.03);
+    if(x < 0.09) return mix(0.15, 1.0, (x - 0.03) / 0.06);
+    if(x < 0.15) return mix(1.0, 0.4, (x - 0.09) / 0.06);
+    if(x < 0.21) return mix(0.4, 1.0, (x - 0.15) / 0.06);
+    if(x < 0.33) return mix(1.0, 0.75, (x - 0.21) / 0.12);
+    if(x < 0.41) return mix(0.75, 1.0, (x - 0.33) / 0.08);
+    return 1.0;
+}
+
+/* easeOutBack: lands with a small overshoot */
+float ease(float u){
+    float c1 = 1.70158;
+    float c3 = c1 + 1.0;
+    float v = u - 1.0;
+    return 1.0 + c3 * v * v * v + c1 * v * v;
+}
+
+/* Four corner brackets of half-size h (ap = abs(p)), arms of length arm,
+   lines of half-thickness th */
+float bracket(vec2 ap, float h, float arm, float th){
+    float bh = step(h - arm, ap.x) * step(ap.x, h + th) * (1.0 - smoothstep(th - 0.5, th + 0.5, abs(ap.y - h)));
+    float bv = step(h - arm, ap.y) * step(ap.y, h + th) * (1.0 - smoothstep(th - 0.5, th + 0.5, abs(ap.x - h)));
+    return max(bh, bv);
+}
+
+void main() {
+    float sc = max(params_float[1], 0.1);
+    float age = mod(time - params_float[0] + 3600.0, 3600.0);
+    if(age > T) discard;
+
+    vec2 p = (v_texcoord - 0.5) * vec2(width, height) / sc;
+    vec3 cb = vec3(params_float[2], params_float[3], params_float[4]);
+    float seed = floor(params_float[0] * 97.0);
+
+    /* fly-in */
+    float u = clamp(age / T_IN, 0.0, 1.0);
+    float h = mix(H0, H1, ease(u));
+    float arm = max(0.45 * h, 6.5);
+    float th = 0.6;
+
+    /* derez: slices drift out, jitter sideways and drop out row by row */
+    float d = clamp((age - T_HOLD) / (T - T_HOLD), 0.0, 1.0);
+    float row = floor(p.y / 2.0);
+    float rh = hash1(seed + row * 0.731);
+    vec2 pj = p;
+    pj.x += (rh - 0.5) * 14.0 * d;
+    h += 9.0 * d;
+    float keep = step(d * 1.15, hash1(seed + row * 1.37 + 0.5));
+    vec2 ap = abs(pj);
+
+    float a_lock = age < T_IN ? 0.85 : flick((age - T_IN) / 0.22);
+    a_lock *= (1.0 - d) * keep;
+
+    float line = bracket(ap, h, arm, th);
+    float glow = bracket(ap, h, arm + 1.5, 2.8) * 0.22;
+    float core = line * a_lock;
+    float gl = glow * a_lock;
+
+    /* motion trail while flying in: ghosts at the last few positions */
+    if(age < T_IN){
+        for(int i = 1; i <= 3; i++){
+            float ua = clamp((age - 0.012 * float(i)) / T_IN, 0.0, 1.0);
+            float hg = mix(H0, H1, ease(ua));
+            gl += bracket(ap, hg, max(0.45 * hg, 6.5), 1.2) * 0.3 / float(i + 1);
+        }
+    }
+
+    vec3 col = cb * (core + gl) + HOT * core * 0.35;
+    float a = core + gl;
+
+    /* centre dot while locked */
+    float r = length(p);
+    float dot_ = (1.0 - smoothstep(0.8, 1.7, r)) * (age < T_IN ? 0.0 : a_lock) * 0.8;
+    col += HOT * dot_;
+    a += dot_;
+
+    /* the press itself: a hot spark that settles fast */
+    float spark = (1.0 - smoothstep(1.5, 3.2, r)) * (1.0 - smoothstep(0.0, 0.18, age));
+    float spark_glow = exp(-r / 9.0) * 0.45 * (1.0 - smoothstep(0.0, 0.3, age));
+    col += HOT * spark + cb * spark_glow;
+    a += spark + spark_glow;
+
+    gl_FragColor = vec4(min(col, vec3(1.0)), clamp(a, 0.0, 1.0)) * alpha;
+}

diff --git a/src/wm/shaders/primitive/tron_cb_hex/fragment.glsl b/src/wm/shaders/primitive/tron_cb_hex/fragment.glsl
new file mode 100644
index 0000000..c362da7
--- /dev/null
+++ b/src/wm/shaders/primitive/tron_cb_hex/fragment.glsl
@@ -0,0 +1,120 @@
+precision highp float;
+/*
+ * Click hex readout, drawn for 0.35 s after a button press: a 4-digit hex
+ * code (hashed from the press time) types out in a 5x7 dot-matrix font
+ * just above and right of the pointer, holds a beat, then drops out: the
+ * dots fall and blink out at random. A new press overwrites it in place.
+ *
+ * 0    time of the press (same clock as time); also the code and the dropout seed
+ * 1    output scale (px per logical px)
+ * 2-4  text colour (r, g, b)
+ */
+uniform float params_float[5];
+uniform float alpha;
+uniform float time;
+varying vec2 v_texcoord;
+
+uniform float width;
+uniform float height;
+
+const float T = 0.35;
+const float T_TYPE = 0.042;          /* per character */
+const float T_DROP = 0.24;           /* dropout starts */
+const float DOT = 2.0;               /* logical px per font dot */
+const float ADV = 6.0;               /* dots per character advance */
+const vec2 ORIGIN = vec2(14.0, -30.0); /* top-left of the text, from the pointer */
+const vec3 HOT = vec3(0.878, 0.984, 1.0);
+
+float hash1(float n){ return fract(sin(n * 127.1) * 43758.5453); }
+
+/* 5x7 glyph of hex digit d: rows 0-3 in x (5 bits each, row 0 highest), rows 4-6 in y */
+vec2 glyph(float d){
+    vec2 g = vec2(0.0);
+    if(d < 0.5) g = vec2(476789.0, 26158.0);
+    else if(d < 1.5) g = vec2(143492.0, 4238.0);
+    else if(d < 2.5) g = vec2(476194.0, 4383.0);
+    else if(d < 3.5) g = vec2(1017986.0, 1582.0);
+    else if(d < 4.5) g = vec2(72018.0, 31810.0);
+    else if(d < 5.5) g = vec2(1033153.0, 1582.0);
+    else if(d < 6.5) g = vec2(205342.0, 17966.0);
+    else if(d < 7.5) g = vec2(1016900.0, 8456.0);
+    else if(d < 8.5) g = vec2(476718.0, 17966.0);
+    else if(d < 9.5) g = vec2(476719.0, 1100.0);
+    else if(d < 10.5) g = vec2(476735.0, 17969.0);
+    else if(d < 11.5) g = vec2(1001022.0, 17982.0);
+    else if(d < 12.5) g = vec2(476688.0, 16942.0);
+    else if(d < 13.5) g = vec2(936497.0, 18012.0);
+    else if(d < 14.5) g = vec2(1032734.0, 16927.0);
+    else if(d < 15.5) g = vec2(1032734.0, 16912.0);
+    return g;
+}
+
+/* 1 when dot (cx, cy) of the 4-character string is lit */
+float lit(vec2 c, float code, float shown){
+    float ch = floor(c.x / ADV);
+    float gx = c.x - ch * ADV;
+    if(ch < 0.0 || ch > 3.0 || ch >= shown || gx > 4.0 || c.y < 0.0 || c.y > 6.0) return 0.0;
+    float d = mod(floor(code / pow(16.0, 3.0 - ch)), 16.0);
+    vec2 g = glyph(d);
+    float bits = c.y < 4.0 ? g.x : g.y;
+    float k = c.y < 4.0 ? 3.0 - c.y : 6.0 - c.y;
+    float row = mod(floor(bits / pow(32.0, k)), 32.0);
+    return mod(floor(row / pow(2.0, 4.0 - gx)), 2.0);
+}
+
+void main() {
+    float sc = max(params_float[1], 0.1);
+    float age = mod(time - params_float[0] + 3600.0, 3600.0);
+    if(age > T) discard;
+
+    vec2 p = (v_texcoord - 0.5) * vec2(width, height) / sc;
+    vec3 cb = vec3(params_float[2], params_float[3], params_float[4]);
+    float seed = floor(params_float[0] * 97.0);
+    float code = floor(hash1(seed + 0.71) * 65536.0);
+
+    /* characters typed so far */
+    float shown = min(floor(age / T_TYPE) + 1.0, 4.0);
+    float drop = clamp((age - T_DROP) / (T - T_DROP), 0.0, 1.0);
+
+    /* dropout: every column of dots falls with its own delay and speed */
+    vec2 q = (p - ORIGIN) / DOT;
+    float colx = floor(q.x);
+    float hc = hash1(seed + colx * 1.913);
+    float fall = max(drop - 0.35 * hc, 0.0);
+    q.y -= fall * fall * (14.0 + 10.0 * hc);
+
+    vec2 cell = floor(q);
+    vec2 f = q - cell - 0.5;
+
+    float col = 0.0;
+    float glow = 0.0;
+    for(int j = -1; j <= 1; j++){
+        for(int i = -1; i <= 1; i++){
+            vec2 c = cell + vec2(float(i), float(j));
+            float on = lit(c, code, shown);
+            if(on < 0.5) continue;
+            /* each dot blinks out at its own moment during the drop */
+            float alive = step(drop, 0.15 + 0.85 * hash1(seed + c.x * 3.17 + c.y * 7.31));
+            vec2 dd = (f - vec2(float(i), float(j))) * DOT;
+            float r = max(abs(dd.x), abs(dd.y));
+            if(i == 0 && j == 0) col = max(col, alive * (1.0 - smoothstep(0.75, 1.05, r)));
+            glow += alive * exp(-length(dd) / 1.8) * 0.16;
+        }
+    }
+
+    /* a character flashes hot white as it is typed */
+    float ch = floor(q.x / ADV);
+    float since = age - ch * T_TYPE;
+    float flash = 1.0 - smoothstep(0.0, 0.06, since);
+
+    /* block cursor at the next slot while typing */
+    float cur = 0.0;
+    if(age < 5.0 * T_TYPE){
+        vec2 cp = q - vec2(shown * ADV, 0.0);
+        cur = step(0.0, cp.x) * step(cp.x, 5.0) * step(0.0, cp.y) * step(cp.y, 7.0) * 0.55;
+    }
+
+    vec3 c3 = mix(cb, HOT, 0.25 + 0.75 * flash) * col + cb * (glow + cur);
+    float a = col + glow + cur;
+    gl_FragColor = vec4(min(c3, vec3(1.0)), clamp(a, 0.0, 1.0)) * alpha;
+}

diff --git a/src/wm/shaders/primitive/tron_cb_border/fragment.glsl b/src/wm/shaders/primitive/tron_cb_border/fragment.glsl
new file mode 100644
index 0000000..46e5e5b
--- /dev/null
+++ b/src/wm/shaders/primitive/tron_cb_border/fragment.glsl
@@ -0,0 +1,96 @@
+precision highp float;
+/*
+ * Focus border in the style of callbetter.com panels (.cc, .cc::before):
+ * 1px cyan border, 18px corner brackets, soft outer glow, and a light that
+ * traces once around the border when focus changes (tbtrace).
+ *
+ * 0-3   colour (r, g, b, a)
+ * 4     corner radius of the border line
+ * 5     inset: widget edge to border line (room for glow and brackets)
+ * 6     glow falloff (px)
+ * 7     time focus changed (same clock as time)
+ * 8     bracket arm length (px)
+ * 9     bracket gap: brackets sit this far outside the border line (px)
+ * 10    output scale
+ */
+uniform float params_float[11];
+uniform float alpha;
+uniform float time;
+varying vec2 v_texcoord;
+
+uniform float width;
+uniform float height;
+
+const float HALF_PI = 1.5707963;
+
+float perimeter_pos(vec2 p, float a, float b, float r){
+    float lq = HALF_PI * r;
+    vec2 ap = abs(p);
+    if(ap.x > a && ap.y > b){
+        vec2 d = p - vec2(sign(p.x) * a, sign(p.y) * b);
+        float ang;
+        float base;
+        if(p.x > 0.0 && p.y < 0.0){ ang = atan(d.x, -d.y); base = 2.0 * a; }
+        else if(p.x > 0.0){ ang = atan(d.y, d.x); base = 2.0 * a + lq + 2.0 * b; }
+        else if(p.y > 0.0){ ang = atan(-d.x, d.y); base = 4.0 * a + 2.0 * b + 2.0 * lq; }
+        else { ang = atan(-d.y, -d.x); base = 4.0 * a + 4.0 * b + 3.0 * lq; }
+        return base + clamp(ang, 0.0, HALF_PI) * r;
+    }
+    bool horizontal = ap.x <= a && (ap.y > b || (a - ap.x) > (b - ap.y));
+    if(horizontal){
+        return p.y < 0.0 ? p.x + a : 2.0 * a + 2.0 * lq + 2.0 * b + (a - p.x);
+    }
+    return p.x > 0.0 ? 2.0 * a + lq + (p.y + b) : 4.0 * a + 2.0 * b + 3.0 * lq + (b - p.y);
+}
+
+void main() {
+    float sc = max(params_float[10], 0.1);
+    vec2 p = (v_texcoord - 0.5) * vec2(width, height);
+    vec2 half_ext = 0.5 * vec2(width, height) - params_float[5];
+    float r = max(min(params_float[4], min(half_ext.x, half_ext.y)), 0.0);
+    vec3 cy = vec3(params_float[0], params_float[1], params_float[2]);
+
+    vec2 q = abs(p) - half_ext + r;
+    float sd = length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
+    float dist = abs(sd);
+
+    /* 1px border and outer glow (box-shadow 0 0 60px) */
+    float line = 1.0 - smoothstep(0.5 * sc, 0.5 * sc + 1.0, dist);
+    float glow = exp(-max(sd, 0.0) / max(params_float[6], 0.1)) * step(0.0, sd);
+    float a = 0.45 * line + 0.10 * glow;
+    vec3 col = cy;
+
+    /* Corner brackets: 18px arms, 1px, just outside the border */
+    float gap = params_float[9];
+    float arm = params_float[8];
+    vec2 c = half_ext + gap;
+    vec2 ap = abs(p);
+    float th = 0.75 * sc + 0.5;
+    float bh = step(c.x - arm, ap.x) * step(ap.x, c.x + th) * (1.0 - smoothstep(th - 0.5, th + 0.5, abs(ap.y - c.y)));
+    float bv = step(c.y - arm, ap.y) * step(ap.y, c.y + th) * (1.0 - smoothstep(th - 0.5, th + 0.5, abs(ap.x - c.x)));
+    float br = max(bh, bv);
+    a = max(a, 0.9 * br);
+
+    /* Trace: one light runs once around the border after a focus change */
+    float age = mod(time - params_float[7] + 3600.0, 3600.0);
+    float T = 0.9;
+    if(age < T + 0.3){
+        float ea = half_ext.x - r;
+        float eb = half_ext.y - r;
+        float perim = 4.0 * (ea + eb) + 4.0 * HALF_PI * r;
+        float s = perimeter_pos(p, ea, eb, r);
+        float pr = clamp(age / T, 0.0, 1.0);
+        pr = 1.0 - pow(1.0 - pr, 3.0);
+        float head = pr * perim;
+        float behind = head - s;
+        float tail = 0.25 * perim;
+        float fadeout = 1.0 - smoothstep(T, T + 0.3, age);
+        float tr = step(0.0, behind) * exp(-3.0 * behind / tail) + exp(-abs(behind) / (3.0 * sc)) * 0.8;
+        float t_line = (line + 0.5 * exp(-dist / (4.0 * sc))) * tr * fadeout;
+        col = mix(col, vec3(1.0), clamp(0.6 * t_line, 0.0, 1.0));
+        a = max(a, clamp(t_line, 0.0, 1.0));
+    }
+
+    a = clamp(a * params_float[3], 0.0, 1.0);
+    gl_FragColor = vec4(col * a, a) * alpha;
+}

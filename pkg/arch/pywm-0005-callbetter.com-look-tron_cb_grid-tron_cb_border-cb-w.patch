+uniform float scale_x;
+uniform float scale_y;
+uniform float width;
+uniform float height;
+
+uniform float padding_l;
+uniform float padding_t;
+uniform float padding_r;
+uniform float padding_b;
+uniform float cornerradius;
+uniform float lock_perc;
+
+uniform float time;
+uniform float fx_age;
+
+/* callbetter.com build-in (tbwipe + tbscan): the window is wiped in from the
+ * left over 0.75s behind a thin cyan scan line. */
+const float WIPE_T = 0.75;
+
+vec4 wipe(vec4 c, float x, float y){
+    if(fx_age >= WIPE_T) return c;
+    float w = max(width - padding_l - padding_r, 1.0);
+    float px = x - padding_l;
+    float t = clamp(fx_age / WIPE_T, 0.0, 1.0);
+    /* ~ cubic-bezier(.25,.6,.2,1) */
+    float p = 1.0 - pow(1.0 - t, 3.0);
+    float front = p * w;
+    float d = front - px;
+    vec3 cyan = vec3(0.133, 0.827, 0.933);
+    float scan_a = t < 0.85 ? 1.0 : 1.0 - (t - 0.85) / 0.15;
+    float scan = (1.0 - smoothstep(1.5, 3.0, abs(d))) * scan_a;
+    float halo = exp(-abs(d) / 10.0) * 0.35 * scan_a;
+    if(d < -3.0){
+        return vec4(cyan * halo, halo) * alpha;
+    }
+    vec3 col = c.rgb + cyan * (scan + halo) * alpha;
+    return vec4(col, max(c.a, (scan + halo) * alpha));
+}

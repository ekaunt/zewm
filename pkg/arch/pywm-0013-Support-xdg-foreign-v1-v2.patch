From 5306d65f9ef5cb2f6f51896895563602c0567407 Mon Sep 17 00:00:00 2001
From: ekaunt <ekaunt@maany.cloud>
Date: Wed, 4 Nov 2026 12:41:23 -0500
Subject: [PATCH 13/14] Support xdg-foreign v1/v2

Dialogs from another process (xdg-desktop-portal file chooser) can now
name their parent toplevel; wlroots sets toplevel->parent and newm floats
the view by its existing parent rule.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 src/wm/wm_server.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/src/wm/wm_server.c b/src/wm/wm_server.c
index 31cb2d2..c05194b 100644
--- a/src/wm/wm_server.c
+++ b/src/wm/wm_server.c
@@ -13,6 +13,9 @@
 #include <wlr/render/allocator.h>
 #include <wlr/config.h>
 #include <wlr/types/wlr_data_control_v1.h>
+#include <wlr/types/wlr_xdg_foreign_registry.h>
+#include <wlr/types/wlr_xdg_foreign_v1.h>
+#include <wlr/types/wlr_xdg_foreign_v2.h>
 #include <wlr/types/wlr_export_dmabuf_v1.h>
 #include <wlr/types/wlr_linux_dmabuf_v1.h>
 #include <wlr/types/wlr_xcursor_manager.h>
@@ -279,6 +282,11 @@ void wm_server_init(struct wm_server* server, struct wm_config* config){
     wlr_export_dmabuf_manager_v1_create(server->wl_display);
     wlr_screencopy_manager_v1_create(server->wl_display);
     wlr_data_control_manager_v1_create(server->wl_display);
+    /* xdg-foreign: lets a dialog in another process (portal file chooser) name its
+     * parent toplevel; wlroots then sets toplevel->parent and the view floats */
+    struct wlr_xdg_foreign_registry* foreign_registry = wlr_xdg_foreign_registry_create(server->wl_display);
+    wlr_xdg_foreign_v1_create(server->wl_display, foreign_registry);
+    wlr_xdg_foreign_v2_create(server->wl_display, foreign_registry);
     wlr_primary_selection_v1_device_manager_create(server->wl_display);
     wlr_gamma_control_manager_v1_create(server->wl_display);
     wlr_viewporter_create(server->wl_display);
-- 

From d4eb488b21705984f773496f61d6e3663ddddd90 Mon Sep 17 00:00:00 2001
From: ekaunt <ekaunt@maany.cloud>
Date: Tue, 29 Sep 2026 19:11:42 -0400
Subject: [PATCH 2/6] tron_grid: flat 2D tile grid with parallax layers

Front layer follows the tile grid of the wall, two fainter layers drift
slower behind it, light cycles random-walk along the tile lines.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 .../shaders/primitive/tron_grid/fragment.glsl | 200 ++++++++----------
 1 file changed, 92 insertions(+), 108 deletions(-)

diff --git a/src/wm/shaders/primitive/tron_grid/fragment.glsl b/src/wm/shaders/primitive/tron_grid/fragment.glsl
index 93cbcb7..c6400c6 100644
--- a/src/wm/shaders/primitive/tron_grid/fragment.glsl
+++ b/src/wm/shaders/primitive/tron_grid/fragment.glsl
@@ -4,15 +4,19 @@ precision highp float;
 precision mediump float;
 #endif
 /*
- * Animated Tron grid: perspective floor, horizon glow, ridge line and
- * two light cycles leaving trails.
+ * Animated Tron grid, flat 2D. The front layer is the tile grid of the wall:
+ * its lines run through the gaps between windows and zoom with them. Two
+ * fainter layers behind it drift slower (parallax). Light cycles race along
+ * the tile lines.
  *
- * 0-3   world box in widget px (x, y, w, h): pans and zooms with the ZUI
+ * 0-1   tile size in px (x, y)
+ * 2-3   screen px of tile coordinate 0 (x, y)
  * 4-6   grid color
  * 7-9   accent color (second light cycle)
- * 10    scroll speed of the floor (units per second)
+ * 10-11 tile the light cycles start from
+ * 12    light cycle speed (tiles per second)
  */
-uniform float params_float[11];
+uniform float params_float[13];
 uniform float alpha;
 uniform float time;
 varying vec2 v_texcoord;
@@ -22,56 +26,48 @@ uniform float height;
 
 float hash1(float n){ return fract(sin(n * 127.1) * 43758.5453); }
 
-/* Distance from p to segment ab, and position of the closest point along it */
-vec2 seg(vec2 p, vec2 a, vec2 b){
-    vec2 ab = b - a;
-    float l = max(length(ab), 1e-4);
-    float t = clamp(dot(p - a, ab) / (l * l), 0.0, 1.0);
-    return vec2(length(p - (a + ab * t)), t * l);
+/* px distance to the nearest line of a grid with cell size cell (px) at origin o */
+vec2 line_dist(vec2 frag, vec2 o, vec2 cell){
+    vec2 t = (frag - o) / cell;
+    return abs(t - floor(t + 0.5)) * cell;
 }
 
-/* Light cycle trail on the floor (camera frame): brightness at floor point fp */
-float cycle(vec2 fp, float seed, float period, float pxw){
-    float ph = time / period + seed;
-    float k = floor(ph);
-    float u = fract(ph);
+float grid_layer(vec2 frag, vec2 o, vec2 cell, float lw){
+    vec2 d = line_dist(frag, o, cell);
+    float m = min(d.x, d.y);
+    return 1.0 - smoothstep(lw * 0.5, lw * 0.5 + 1.0, m);
+}
 
-    /* Path: runs toward the camera along Z with lateral 90 degree turns */
-    vec2 a = vec2(floor((hash1(k + seed * 7.0) - 0.5) * 14.0), 46.0);
-    float total = 0.0;
-    vec2 pts[9];
-    pts[0] = a;
-    for(int i = 1; i < 9; i++){
-        vec2 prev = pts[i - 1];
-        if(mod(float(i), 2.0) > 0.5){
-            prev.y -= 5.0 + floor(hash1(k * 13.0 + float(i) + seed) * 6.0);
-        }else{
-            float dx = floor((hash1(k * 17.0 + float(i) + seed * 3.0) - 0.5) * 10.0);
-            if(abs(prev.x + dx) > 9.0) dx = -dx;
-            prev.x += dx;
-        }
-        pts[i] = prev;
-        total += length(pts[i] - pts[i - 1]);
-    }
+/* Light cycle: random walk along tile lines, one tile per step */
+float cycle(vec2 frag, vec2 o, vec2 tile, float seed, float speed, out float head_glow){
+    float steps = 14.0;
+    float run = time * speed / steps + seed;
+    float k = floor(run);
+    float u = fract(run) * steps;
 
-    float head = u * total;
-    float tail = 16.0;
+    vec2 p = vec2(params_float[10], params_float[11])
+           + floor(vec2(hash1(k + seed), hash1(k * 3.1 + seed)) * 4.0) - 2.0;
+    vec2 dir = vec2(1.0, 0.0);
     float best = 0.0;
-    float acc = 0.0;
-    for(int i = 1; i < 9; i++){
-        float l = length(pts[i] - pts[i - 1]);
-        if(acc < head){
-            vec2 b = pts[i];
-            if(acc + l > head) b = pts[i - 1] + (pts[i] - pts[i - 1]) * ((head - acc) / max(l, 1e-4));
-            vec2 d = seg(fp, pts[i - 1], b);
-            float behind = head - (acc + d.y);
-            float fade = exp(-behind / tail * 2.5);
-            float w = max(0.05, pxw);
-            float core = 1.0 - smoothstep(w, w * 2.0, d.x);
-            float glow = exp(-d.x / 0.35) * 0.5;
-            best = max(best, (core + glow) * fade);
-        }
-        acc += l;
+    head_glow = 0.0;
+    float tail = 3.5;
+    for(int i = 0; i < 14; i++){
+        float fi = float(i);
+        if(fi > u) break;
+        float r = hash1(k * 7.3 + fi * 1.7 + seed * 11.0);
+        if(r < 0.3) dir = vec2(-dir.y, dir.x);
+        else if(r < 0.6) dir = vec2(dir.y, -dir.x);
+        float len = min(1.0, u - fi);
+        vec2 a = o + p * tile;
+        vec2 b = o + (p + dir * len) * tile;
+        vec2 ab = b - a;
+        float t = clamp(dot(frag - a, ab) / max(dot(ab, ab), 1e-4), 0.0, 1.0);
+        float d = length(frag - (a + ab * t));
+        float behind = u - (fi + t * len);
+        float fade = exp(-behind / tail * 2.5) * smoothstep(steps, steps - 1.0, u);
+        best = max(best, ((1.0 - smoothstep(1.5, 2.5, d)) + exp(-d / 9.0) * 0.6) * fade);
+        if(fi + 1.0 > u) head_glow = exp(-length(frag - b) / 14.0);
+        p += dir * len;
     }
     return best;
 }
@@ -80,65 +76,53 @@ void main() {
     vec2 frag = v_texcoord * vec2(width, height);
     vec3 gcol = vec3(params_float[4], params_float[5], params_float[6]);
     vec3 acol = vec3(params_float[7], params_float[8], params_float[9]);
-
-    /* Camera from the ZUI viewport: pan sideways/forward, rise when zoomed out */
-    float bw = max(params_float[2], 1.0);
-    float bh = max(params_float[3], 1.0);
-    float pan_x = (0.5 * width - params_float[0]) / bw;

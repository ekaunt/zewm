-    float vis = clamp(width / bw, 0.05, 1.0);
-    float cam_h = 0.8 + 2.5 * vis;
-
-    vec2 q = (frag - 0.5 * vec2(width, height)) / height;
-    float hy = -0.08;
-    float d = q.y - hy;
-
-    /* Sky */
-    vec3 col = mix(vec3(0.02, 0.07, 0.10), vec3(0.0, 0.005, 0.015), smoothstep(0.0, 0.5, -d));
-
-    /* Distant ridge with a lit edge */
-    float rx = q.x + pan_x * 0.6;
-    float ridge = 0.045 * (0.6 + 0.4 * sin(rx * 3.1 + 1.3)) * (0.5 + 0.5 * sin(rx * 7.3))
-                + 0.02 * sin(rx * 17.0 + 0.7);
-    ridge = max(ridge, 0.0);
-    float ry = hy - ridge;
-    if(q.y > ry && d < 0.0) col = vec3(0.0, 0.01, 0.02);
-    col += gcol * exp(-abs(q.y - ry) * height / 1.5) * 0.7 * step(0.002, ridge);
-
-    if(d > 0.0){
-        /* Floor */
-        float z = cam_h / d;
-        float x = q.x * z;
-        vec2 fp = vec2(x + pan_x * 60.0, z + time * params_float[10] + pan_z * 60.0);
-
-        float pxz = cam_h / (d * d * height);
-        float pxx = z / height;
-        vec2 cellp = abs(fract(fp) - 0.5);
-        vec2 lw = max(vec2(pxx, pxz) * 0.9, vec2(0.012));
-        float lx = 1.0 - smoothstep(0.5 - lw.x * 2.0, 0.5 - lw.x, cellp.x);
-        float lz = 1.0 - smoothstep(0.5 - lw.y * 2.0, 0.5 - lw.y, cellp.y);
-        /* Fade lines out where they get thinner than a pixel */
-        lx = (1.0 - lx) * (1.0 - smoothstep(0.08, 0.35, pxx));
-        lz = (1.0 - lz) * (1.0 - smoothstep(0.08, 0.35, pxz));
-        float grid = max(lx, lz);
-        float gglow = exp(-min(0.5 - cellp.x, 0.5 - cellp.y) / 0.08) * 0.25;
-
-        float fog = exp(-z * 0.045);
-        col = mix(col, vec3(0.0, 0.01, 0.02), 1.0 - exp(-d * 10.0));
-        col += gcol * (grid * 0.85 + gglow) * fog;
-
-        /* Light cycles run in the camera frame */
-        vec2 cp = vec2(x, z);
-        float pxw = max(pxx, pxz);
-        col += gcol * 1.3 * cycle(cp, 0.13, 9.0, pxw) * exp(-z * 0.03);
-        col += acol * 1.3 * cycle(cp, 0.61, 11.0, pxw) * exp(-z * 0.03);
+    vec2 tile = max(vec2(params_float[0], params_float[1]), vec2(1.0));
+    vec2 o = vec2(params_float[2], params_float[3]);
+
+    /* Camera: centre in tile units and tiles visible across */
+    vec2 screen = vec2(width, height);
+    vec2 centre = (0.5 * screen - o) / tile;
+    float size = width / tile.x;
+
+    /* Base: deep navy, slightly lifted in the middle */
+    vec2 q = v_texcoord - 0.5;
+    vec3 col = mix(vec3(0.004, 0.018, 0.03), vec3(0.0, 0.004, 0.01), smoothstep(0.1, 0.75, length(q)));
+
+    /* Parallax layers: farther layers pan and zoom less */
+    for(int l = 0; l < 2; l++){
+        float f = l == 0 ? 0.3 : 0.6;
+        float density = l == 0 ? 8.0 : 4.0;
+        float lsize = pow(max(size, 0.05), f) * density;
+        vec2 cell = vec2(width, width * tile.y / tile.x) / lsize;
+        vec2 lo = 0.5 * screen - centre * f * density * cell;
+        float g = grid_layer(frag, lo, cell, 1.0);
+        col += gcol * g * (l == 0 ? 0.05 : 0.09);
     }
 
-    /* Horizon glow */
-    float hd = abs(d);
-    col += mix(gcol, vec3(1.0), 0.5) * exp(-hd * height / 2.0) * 0.9;
-    col += gcol * exp(-hd * 14.0) * 0.25;
-
-    col = 1.0 - exp(-col * 1.4);
+    /* Front layer: the tile grid, with quarter-tile subdivisions */
+    float sub = grid_layer(frag, o, tile / 4.0, 1.0);
+    col += gcol * sub * 0.07;
+
+    vec2 d = line_dist(frag, o, tile);
+    float m = min(d.x, d.y);
+    float core = 1.0 - smoothstep(0.75, 1.75, m);
+    float glow = exp(-m / 10.0);
+    /* Energy pulses travelling along the lines */
+    vec2 t = (frag - o) / tile;
+    float along = d.x < d.y ? t.y : t.x;
+    float pulse = 0.55 + 0.45 * pow(0.5 + 0.5 * sin(along * 6.2832 - time * 1.3), 6.0);
+    col += gcol * (core * 0.75 + glow * 0.22) * pulse;
+
+    /* Crossings of the tile grid */
+    float cross = exp(-length(d) / 5.0);
+    col += mix(gcol, vec3(1.0), 0.5) * cross * 0.5;
+
+    /* Light cycles */
+    float h1, h2;
+    col += gcol * 1.4 * cycle(frag, o, tile, 0.17, params_float[12], h1);
+    col += acol * 1.4 * cycle(frag, o, tile, 0.63, params_float[12] * 0.85, h2);
+    col += vec3(1.0) * (h1 + h2) * 0.6;
+
+    col = 1.0 - exp(-col * 1.3);
     gl_FragColor = vec4(col, 1.0) * alpha;
 }
